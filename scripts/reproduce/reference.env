# The final configuration (Qwen2.5-32B on one H200), in one place. Every script in scripts/reproduce sources this file.
# User-facing overrides (export before running a script): VA_MODEL, VA_DATA, VA_DATASET, VA_OUT, VA_NOISE_GBS.
# What each setting selects: schemes/memory_link_exhaustion/docs/DESIGN.md.
export VA_MODEL=${VA_MODEL:-/root/models/Qwen2.5-32B-Instruct}
export VA_DATA=${VA_DATA:-/root/data/ShareGPT_V3_unfiltered_cleaned_split.json}
# Workload, passed as --dataset: sharegpt (prompts from VA_DATA; every published floor and verdict) or random (random
# tokens). Without this the runners fall back to random, whatever VA_DATA points at.
export VA_DATASET=${VA_DATASET:-sharegpt}
export VA_OUT=${VA_OUT:-results/reproduce}
# Nominal noise schedule in GB/s: above the link, so the routed noise runs back to back (saturating; one window revealed
# as one completes, 4 in flight)
export VA_NOISE_GBS=${VA_NOISE_GBS:-60}

# Engine (baseline and prover alike); KV blocks and the per-step token cap
export VLLM_BATCH_INVARIANT=1 VARENA_TRITON_GEMM=1 VARENA_KV_HEADS=8 VARENA_W_BFLY_L=11 VARENA_WFUSE_GU_M=256
export VA_NB=10240 VA_TOKCAP=1024

# Prover (16 Nov): butterfly W (L=11) / KV / filler, stale KV; the gate_up GEMM fused with its butterfly decode at decode
# steps (M < 512, 256-row CTA for 128 < M <= 256), every other W decoded ahead into scratch at 2 blocks per SM (smoothed:
# less HBM burst, so less dent in the link noise) and multiplied by the pre-emptible matmul copy (exits at the challenge
# gate instead of parking); sliced decode-ahead for large W (270 MiB), matmul gate, 2 reserved SMs, 1 GiB pre-reserve
export VA_PROVER_ENV="VARENA_ATT_CLAMP=0 VARENA_ATT_BLOCK_M_PREFILL=32 VARENA_RESERVE_SMS=2 VARENA_MM_GATE=1 VARENA_STALE_KV=1 VARENA_KVENC=bfly VARENA_KV_BFLY_L=8 VARENA_PRERESERVE_MIB=1024 VARENA_WENC=bfly VARENA_FILLER=bfly VARENA_CUDA_GEMM=1 VARENA_PAUSE_VLLM=1 VARENA_ZEROCOPY=1 VARENA_BFLY_AHEAD_M=512 VARENA_BFLY_FUSE_KINDS=gate_up VARENA_BFLY_XOR_SMEM_KB=45 VARENA_AE_PREEMPT=1 VARENA_AHEAD_AE=1 VARENA_WDEC_SLICE_MB=270"

# Verifier (14 Nov): one challenge, the mixed chase over W, KV, filler and every slot of the noise ring (a read in
# the 24 slots that incoming windows overwrite returns a tag: --ring-tag 1), on a public sequential noise schedule. KV: the chase reads every position, in-flight ones too, and
# returns a tag per in-flight read (--kv-table 3); the block table that says who wrote what is derived by the verifier
# from the scheduler's call order (--kv-table-derive 1), and one chain of every answer is replayed from sources. Link
# rules = end-of-session rate and head rule against the host's floor (floors.sh); chase tail rule: at most one answer per session slower than the multiple of T in floors.env (at least 1.5).
export VA_UNIFIED_FLAGS="--noise-perm ${VA_NOISE_PERM:-2} --ring-chase-guard ${VA_RING_CHASE_GUARD:-24} --kv-tab-test ${VA_KV_TAB_TEST:-0} --kv-table ${VA_KV_TABLE:-3} --kv-table-derive ${VA_KV_DERIVE:-1} --replay-all ${VA_REPLAY_ALL:-1} --hard-mult 1.5"
# Cheater and check_host runs (scripts/reproduce/lib.sh PR); honest runs use the cfg:ref line of
# schemes/memory_link_exhaustion/scripts/timing_runs.sh with the same rates. Cheater runs pass --calib, which sets the
# allowance (the honest run's outside bytes + its 1/16 GiB margin); --pad-mib only sizes an honest prover.
export VA_VERIFIER_FLAGS="--noise-sched 1 --window-mib 32 --pool-mib 65536 --noise-gbs $VA_NOISE_GBS --lag 2 --ring-mib 2048 --mchase-rate 4 --check-max 2 --mchase-verify 20 --max-excused 0.1 --max-batched-tokens $VA_TOKCAP $VA_UNIFIED_FLAGS ${VA_EXTRA_FLAGS:-}"
[ -f /root/env.sh ] && . /root/env.sh
# Cheater runs: short by default. The pretraining cheaters serve 450 prompts (catalogue: ~2 optimizer
# steps) and the post-run content check samples 4 chains: VA_XFLAGS comes last on the verifier command line, so its
# --mchase-verify 4 overrides the 20 in VA_VERIFIER_FLAGS above (the link and timing verdicts are unchanged). Set
# VA_XFLAGS="" for a full-check run (20 chains).
export VA_XFLAGS=${VA_XFLAGS---mchase-verify 4}
